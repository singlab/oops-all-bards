package abl.generated;

import abl.wmes.*;
import abl.actions.*;
import abl.sensors.*;
import abl.util.*;
import java.util.*;

behaving_entity WurguthAgent {

    register act moveToPosition(int, float, float, float) with MoveToPosition;
    register act observeTarget(int, int, float) with ObserveTarget;
    register act calmConfrontation(int, int) with CalmConfrontation;
    register act aggressiveConfrontation(int, int) with AggressiveConfrontation;

    sequential behavior protectGuild(int characterId) {
        mental_act {
            System.out.println("Wurguth: Top-level goal 'protectGuild' activated for characterID = " + characterId);
        }
        with (persistent) subgoal manageGuildProtection(characterId);
    }

    parallel behavior manageGuildProtection(int characterId) {
        with(success_test{ (1 == 2) }) wait;
    }

    sequential behavior performCalmConfrontation(int characterId, int targetId) {
        mental_act {
            System.out.println("ABL: Wurguth is starting performCalmConfrontation with targetID = " + targetId);
        }
        act calmConfrontation(characterId, targetId);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="CalmConfrontation" status=="Success") }) wait;
        mental_act {
            System.out.println("ABL: Wurguth has successfully completed performCalmConfrontation.");
        }
    }

    sequential behavior performAggressiveConfrontation(int characterId, int targetId) {
        mental_act {
            System.out.println("ABL: Wurguth is starting performAggressiveConfrontation with targetID = " + targetId);
        }
        act aggressiveConfrontation(characterId, targetId);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="AggressiveConfrontation" status=="Success") }) wait;
        mental_act {
            System.out.println("ABL: Wurguth has successfully completed performAggressiveConfrontation.");
        }
    }

    sequential behavior performObservation(int characterId, int targetId, float duration) {
        mental_act {
            System.out.println("ABL: Wurguth is starting performObservation of targetID = " + targetId);
        }
        act observeTarget(characterId, targetId, duration);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="Observe" status=="Success") }) wait;
        mental_act {
            System.out.println("ABL: Wurguth has completed performObservation.");
        }
    }

    sequential behavior performMoveTo(int characterId, float x, float y, float z) {
        mental_act {
            System.out.println("ABL: Wurguth is starting performMoveTo location " + x + "," + y + "," + z);
        }
        act moveToPosition(characterId, x, y, z);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="Move" status=="Success") }) wait;
        mental_act {
            System.out.println("ABL: Wurguth has completed performMoveTo.");
        }
    }
}