package abl.generated;
// the package corresponds to where generated Java files are placed.

import abl.wmes.*;
import abl.actions.*;
import abl.sensors.*;
import abl.util.*;

behaving_entity GameAgent {
    
	// Register all low-level physical acts that map to ICharacterBehaviors in Unity.
    register act moveToPosition(int, float, float, float) with MoveToPosition;
    register act observeTarget(int, int, float) with ObserveTarget;
    register act calmConfrontation(int, int) with CalmConfrontation;
    register act aggressiveConfrontation(int, int) with AggressiveConfrontation;

    // A utility class (defined in Java) to hold the most recent WME for each character.
    VivWMEDictionary dict = new VivWMEDictionary();

    parallel behavior vivAgentRoot() {
        with (success_test { (true) }) wait;
    }

    sequential behavior lookForVivCommands() {
        VivWME vivCommand;
        ParallelBehaviorWME rootSpawnPoint;
        int characterId;

        with (success_test {
                vivCommand = (VivWME OnTree==false)
                rootSpawnPoint = (ParallelBehaviorWME signature=="vivAgentRoot()")
            }) wait;
        
        mental_act { vivCommand.setOnTree(true); }
        mental_act { characterId = vivCommand.getID(); }

        if { (!dict.containsKey(characterId)) } {
            spawngoal manageVivCharacter(characterId) at rootSpawnPoint;
        }

        mental_act { dict.addCharacter(characterId, vivCommand); }
        subgoal processSpawnGoals(characterId);
    }

    parallel behavior manageVivCharacter(int characterId) {
        mental_act {
            abl.wmes.ParallelBehaviorWME me = getBehaviorWME();
            System.out.println("ABL: Linking manager behavior " + me.getID() + " to character " + characterId);
            addWME(new CharacterManagerWME(characterId, me.getID()));
        }
    }

    sequential behavior processSpawnGoals(int characterId) {
        VivWME vivCommand;
        CharacterManagerWME linkWME;
        ParallelBehaviorWME characterSpawnPoint;
		int targetId;

        mental_act { vivCommand = dict.getCharacter(characterId); }
        with (success_test {
                linkWME = (CharacterManagerWME characterId==characterId)
                characterSpawnPoint = (ParallelBehaviorWME behaviorID==linkWME.managerBehaviorId)
            }) wait;

		if { (vivCommand.hasGoal("investigateSuspiciousActivity")) } {
			mental_act { targetId = vivCommand.getTargetIdForGoal("investigateSuspiciousActivity"); }
			spawngoal investigateSuspiciousActivity(characterId, targetId) at characterSpawnPoint;
		}
	
		if { (vivCommand.hasGoal("neutralizeThreat")) } {
			mental_act { targetId = vivCommand.getTargetIdForGoal("neutralizeThreat"); }
			spawngoal neutralizeThreat(characterId, targetId) at characterSpawnPoint;
		}
	
		if { (vivCommand.hasGoal("gatherInformation")) } {
			mental_act { targetId = vivCommand.getTargetIdForGoal("gatherInformation"); }
			spawngoal gatherInformation(characterId, targetId) at characterSpawnPoint;
		}
	
		if { (vivCommand.hasGoal("maintainGuildSecrecy")) } {
			mental_act { targetId = vivCommand.getTargetIdForGoal("maintainGuildSecrecy"); }
			spawngoal maintainGuildSecrecy(characterId, targetId) at characterSpawnPoint;
		}
		
		mental_act {
			System.out.println("ABL: Finished processing spawn goals, deleting command WME.");
			deleteWME(vivCommand);
		}
    }

    //
    // HIGH-LEVEL TACTIC IMPLEMENTATIONS (The "Plans")
    //
    sequential behavior investigateSuspiciousActivity(int characterId, int targetId) {
        mental_act { System.out.println("ABL Tactic: Character " + characterId + " is investigating " + targetId); }
        act moveToPosition(characterId, 10.0f, 0.0f, 25.5f); // Example coordinates
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="Move" status=="Success") }) wait;
        act observeTarget(characterId, targetId, 15.0f);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="Observe" status=="Success") }) wait;
    }

    sequential behavior neutralizeThreat(int characterId, int targetId) {
        mental_act { System.out.println("ABL Tactic: Character " + characterId + " is neutralizing threat " + targetId); }
        act aggressiveConfrontation(characterId, targetId);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="AggressiveConfrontation" status=="Success") }) wait;
    }

    sequential behavior gatherInformation(int characterId, int targetId) {
        mental_act { System.out.println("ABL Tactic: Character " + characterId + " is gathering info on " + targetId); }
        act observeTarget(characterId, targetId, 30.0f);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="Observe" status=="Success") }) wait;
    }

    sequential behavior maintainGuildSecrecy(int characterId, int targetId) {
        mental_act { System.out.println("ABL Tactic: Character " + characterId + " is maintaining secrecy from " + targetId); }
        act calmConfrontation(characterId, targetId);
        with(success_test { (BehaviorStatusWME characterID==characterId behaviorName=="CalmConfrontation" status=="Success") }) wait;
    }

	// The root of the ABL program. It runs two persistent, parallel behaviors:
    //  1. vivAgentRoot: The container where all character-specific managers are spawned.
    //  2. lookForVivCommands: The "listener" that waits for commands from Viv.
    initial_tree {
        with (persistent) subgoal vivAgentRoot();
        with (persistent) subgoal lookForVivCommands();
    }
}